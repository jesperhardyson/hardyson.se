---
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import { tools } from '../i18n/ui';
import jesperPhoto from '../assets/jesper.jpg';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="section about" id="about">
	<div class="container inner">
		<div class="photo">
			<Image src={jesperPhoto} alt={t('about.photoAlt')} width={460} height={560} />
		</div>
		<div class="content">
			<span class="eyebrow">{t('about.eyebrow')}</span>
			<h2>{t('about.title')}</h2>
			<div class="bio">
				<p>{t('about.bio1')}</p>
			</div>
			<span class="tools-label">{t('about.tools')}</span>
			<ul class="tools">
				{tools.map((tool) => (
					<li class="tag-pill">{tool}</li>
				))}
			</ul>
		</div>
	</div>
</section>

<style>
	.inner {
		display: flex;
		gap: 64px;
		align-items: flex-start;
	}
	.photo {
		flex-shrink: 0;
		width: 460px;
		height: 560px;
		border-radius: 24px;
		overflow: hidden;
		background: var(--accent-tint);
	}
	.photo :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.content {
		flex: 1;
		min-width: 0;
		padding-top: 12px;
	}
	h2 {
		font-size: 38px;
		font-weight: 600;
		line-height: 1.15;
		color: var(--ink);
	}
	.bio {
		margin-top: 24px;
		display: flex;
		flex-direction: column;
		gap: 16px;
		color: var(--ink-soft);
		font-size: 17px;
		line-height: 1.65;
	}
	.tools-label {
		display: block;
		margin-top: 40px;
		margin-bottom: 16px;
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 1px;
		color: var(--ink);
	}
	.tools {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	@media (max-width: 900px) {
		.inner {
			flex-direction: column;
			gap: 32px;
		}
		.photo {
			width: 100%;
			height: 360px;
		}
	}
</style>

---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n/utils';
import { useTranslations, formatArticleDate } from '../i18n/utils';

interface Props {
	article: CollectionEntry<'articles'>;
	href: string;
	lang: Lang;
}

const { article, href, lang } = Astro.props;
const t = useTranslations(lang);
---

<a class="card" href={href} data-category={article.data.category}>
	<span class="tag">{article.data.category}</span>
	<h3>{article.data.title}</h3>
	<p>{article.data.excerpt}</p>
	<div class="meta">
		<span>{formatArticleDate(article.data.date, lang)}</span>
		<span class="dot">·</span>
		<span>{article.data.readingMinutes} {t('articles.readingSuffix')}</span>
	</div>
</a>

<style>
	.card {
		display: block;
		padding: 24px;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--surface);
		text-decoration: none;
		color: inherit;
		transition: border-color 0.15s ease;
	}
	.card:hover {
		border-color: var(--accent);
	}
	.tag {
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 600;
		color: var(--accent);
	}
	.card h3 {
		margin-top: 10px;
		font-family: var(--font-display);
		font-size: 21px;
		font-weight: 600;
		line-height: 1.25;
		color: var(--ink);
	}
	.card p {
		margin-top: 8px;
		color: var(--ink-soft);
		font-size: 15px;
		line-height: 1.55;
	}
	.meta {
		margin-top: 16px;
		display: flex;
		gap: 8px;
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--ink-soft);
	}
</style>

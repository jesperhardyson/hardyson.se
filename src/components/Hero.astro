---
import type { Lang } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import { socials } from '../i18n/ui';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const projectsHref = lang === 'sv' ? '/projects/' : '/en/projects/';
---

<section class="hero">
	<div class="glow glow-1"></div>
	<div class="glow glow-2"></div>
	<div class="container grid">
		<div class="copy">
			<span class="role">{t('hero.role')}</span>
			<h1>{t('hero.h1.a')} <span class="accent">{t('hero.h1.accent')}</span> {t('hero.h1.b')}</h1>
			<p class="sub">{t('hero.sub')}</p>
			<div class="cta">
				<a class="btn btn-primary" href={projectsHref}>
					{t('hero.cta.primary')}
					<svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M7 17 17 7M7 7h10v10" />
					</svg>
				</a>
				<div class="socials">
					<a href={socials.github} target="_blank" rel="noreferrer" aria-label="GitHub">
						<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.089-.744.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.605-2.665-.3-5.467-1.332-5.467-5.93 0-1.31.469-2.381 1.236-3.221-.124-.303-.535-1.523.117-3.176 0 0 1.008-.322 3.301 1.23A11.5 11.5 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.873.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.61-2.807 5.625-5.479 5.921.43.372.823 1.102.823 2.222 0 1.606-.015 2.898-.015 3.293 0 .322.216.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
					</a>
					<a href={socials.linkedin} target="_blank" rel="noreferrer" aria-label="LinkedIn">
						<svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
					</a>
				</div>
			</div>
		</div>
		<div class="panel" aria-hidden="true">
			<div class="panel-head">
				<span class="dots"><i></i><i></i><i></i></span>
				<span class="file">{t('hero.panel.file')}</span>
			</div>
			<div class="panel-body">
				<p><span class="prompt">$ </span>dotnet test</p>
				{['AuthTests', 'CheckoutTests', 'PaymentApiTests', 'AccessibilityTests'].map((name) => (
					<p><span class="check">✓</span> {name} <span class="passed">passed</span></p>
				))}
				<p class="summary">
					<span class="passed">{t('hero.panel.passed')}</span> {t('hero.panel.tests')}<span class="dim">{t('hero.panel.total')}</span>
				</p>
				<p class="dim">{t('hero.panel.duration')}<span class="bright">14.2s</span></p>
				<p><span class="prompt">$ </span><span class="cursor"></span></p>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		padding-block: 72px 96px;
	}
	.glow {
		position: absolute;
		border-radius: 50%;
		filter: blur(80px);
		z-index: 0;
		pointer-events: none;
	}
	.glow-1 {
		background: var(--accent);
		width: 660px;
		height: 480px;
		left: -160px;
		top: -140px;
		animation: drift-1 12s ease-in-out infinite;
	}
	.glow-2 {
		background: var(--accent-2);
		width: 480px;
		height: 440px;
		right: -120px;
		top: 20px;
		animation: drift-2 15s ease-in-out infinite;
	}
	@keyframes drift-1 {
		0%,
		100% {
			transform: translate(0, 0) scale(1);
			opacity: 0.14;
		}
		50% {
			transform: translate(120px, 70px) scale(1.25);
			opacity: 0.26;
		}
	}
	@keyframes drift-2 {
		0%,
		100% {
			transform: translate(0, 0) scale(1);
			opacity: 0.12;
		}
		50% {
			transform: translate(-100px, 90px) scale(1.3);
			opacity: 0.24;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.glow-1,
		.glow-2 {
			animation: none;
			opacity: 0.16;
		}
	}
	.grid {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: 1fr 1.15fr;
		gap: 64px;
		align-items: stretch;
	}
	.role {
		display: block;
		font-family: var(--font-mono);
		font-size: 13px;
		font-weight: 500;
		color: var(--ink-soft);
		margin-bottom: 20px;
	}
	h1 {
		font-size: 56px;
		font-weight: 600;
		letter-spacing: -1.5px;
		line-height: 1.05;
		color: var(--ink);
	}
	h1 .accent {
		color: var(--accent);
	}
	.sub {
		margin-top: 24px;
		max-width: 520px;
		color: var(--ink-soft);
		font-size: 18px;
		line-height: 1.6;
	}
	.cta {
		margin-top: 32px;
		display: flex;
		align-items: center;
		gap: 24px;
		flex-wrap: wrap;
	}
	.btn-icon {
		width: 16px;
		height: 16px;
	}
	.socials {
		display: flex;
		align-items: center;
		gap: 18px;
	}
	.socials a {
		color: var(--ink-soft);
		display: flex;
	}
	.socials a:hover {
		color: var(--ink);
	}
	.socials svg {
		width: 20px;
		height: 20px;
	}
	.panel {
		display: flex;
		flex-direction: column;
		min-height: 380px;
		background: var(--bg-warm);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		overflow: hidden;
		box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.6);
	}
	.panel-head {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 14px 20px;
		background: var(--surface);
		border-bottom: 1px solid var(--line);
	}
	.dots {
		display: flex;
		gap: 7px;
	}
	.dots i {
		width: 11px;
		height: 11px;
		border-radius: 50%;
		display: block;
	}
	.dots i:nth-child(1) {
		background: #ff5f56;
	}
	.dots i:nth-child(2) {
		background: #ffbd2e;
	}
	.dots i:nth-child(3) {
		background: #27c93f;
	}
	.file {
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--ink-soft);
	}
	.panel-body {
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 10px;
		padding: 32px 28px;
		font-family: var(--font-mono);
		font-size: 15px;
		line-height: 1.6;
	}
	.panel-body p {
		color: var(--ink);
	}
	.prompt,
	.dim {
		color: var(--ink-soft);
	}
	.check,
	.passed {
		color: var(--accent);
	}
	.bright {
		color: var(--ink);
	}
	.summary {
		margin-top: 8px;
	}
	.cursor {
		display: inline-block;
		width: 8px;
		height: 15px;
		margin-left: 2px;
		background: var(--accent);
		vertical-align: -2px;
		animation: blink 1s step-end infinite;
	}
	@keyframes blink {
		50% {
			opacity: 0;
		}
	}
	@media (max-width: 900px) {
		.grid {
			grid-template-columns: 1fr;
		}
		h1 {
			font-size: 40px;
		}
	}
</style>

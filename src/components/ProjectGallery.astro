---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	images: ImageMetadata[];
}

const { images } = Astro.props;
const wideFirst = images.length === 2;
const multiple = images.length > 1;
---

{
	images.length > 0 && (
		<>
			<div class="gallery">
				{images.map((img, i) => (
					<button type="button" class={`shot ${i === 0 && wideFirst ? 'wide' : ''}`} data-lightbox-trigger data-index={i} aria-label="Öppna bild">
						<Image
							src={img}
							alt=""
							width={images.length === 1 ? 760 : i === 0 && wideFirst ? 520 : 260}
							height={images.length === 1 ? 420 : 400}
						/>
					</button>
				))}
			</div>

			<dialog class="lightbox">
				<button type="button" class="close" data-lightbox-close aria-label="Stäng">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M18 6 6 18M6 6l12 12" />
					</svg>
				</button>
				{multiple && (
					<button type="button" class="nav prev" data-lightbox-prev aria-label="Föregående bild">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="m15 18-6-6 6-6" />
						</svg>
					</button>
				)}
				{images.map((img, i) => (
					<Image src={img} alt="" width={1400} data-lightbox-image data-index={i} />
				))}
				{multiple && (
					<button type="button" class="nav next" data-lightbox-next aria-label="Nästa bild">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="m9 18 6-6-6-6" />
						</svg>
					</button>
				)}
			</dialog>
		</>
	)
}

<style>
	.gallery {
		margin-top: 32px;
		display: flex;
		gap: 16px;
		max-width: 760px;
	}
	.shot {
		flex: 1;
		height: 400px;
		padding: 0;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		overflow: hidden;
		background: var(--accent-tint);
		cursor: pointer;
	}
	.shot.wide {
		flex: 2;
	}
	.shot :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.lightbox {
		border: none;
		background: transparent;
		padding: 0;
		max-width: 92vw;
		max-height: 92vh;
	}
	.lightbox::backdrop {
		background: rgba(0, 0, 0, 0.85);
	}
	.lightbox :global(img) {
		display: none;
		max-width: 92vw;
		max-height: 92vh;
		width: auto;
		height: auto;
		border-radius: 8px;
	}
	.close,
	.nav {
		position: fixed;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		border-radius: 50%;
		background: var(--surface);
		border: 1px solid var(--line);
		color: var(--ink);
		cursor: pointer;
	}
	.close {
		top: 20px;
		right: 24px;
	}
	.close svg {
		width: 18px;
		height: 18px;
	}
	.nav {
		top: 50%;
		transform: translateY(-50%);
	}
	.nav svg {
		width: 20px;
		height: 20px;
	}
	.nav.prev {
		left: 24px;
	}
	.nav.next {
		right: 24px;
	}
	.nav:hover,
	.close:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
	@media (max-width: 700px) {
		.gallery {
			flex-direction: column;
		}
		.shot {
			height: 280px;
		}
		.nav.prev {
			left: 8px;
		}
		.nav.next {
			right: 8px;
		}
	}
</style>

<script>
	function setup() {
		const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
		if (!dialog) return;

		const triggers = document.querySelectorAll<HTMLButtonElement>('[data-lightbox-trigger]');
		const images = Array.from(dialog.querySelectorAll<HTMLElement>('[data-lightbox-image]'));
		let current = 0;

		function show(index: number) {
			current = (index + images.length) % images.length;
			images.forEach((img, i) => {
				img.style.display = i === current ? 'block' : 'none';
			});
		}

		triggers.forEach((btn) => {
			btn.addEventListener('click', () => {
				show(Number(btn.dataset.index));
				dialog.showModal();
			});
		});

		dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
		dialog.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => show(current - 1));
		dialog.querySelector('[data-lightbox-next]')?.addEventListener('click', () => show(current + 1));

		dialog.addEventListener('click', (e) => {
			if (e.target === dialog) dialog.close();
		});

		dialog.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') {
				dialog.close();
			} else if (e.key === 'ArrowLeft' && images.length > 1) {
				e.preventDefault();
				show(current - 1);
			} else if (e.key === 'ArrowRight' && images.length > 1) {
				e.preventDefault();
				show(current + 1);
			}
		});
	}

	document.addEventListener('astro:page-load', setup);
</script>

---
import Base from '../../../layouts/Base.astro';
import { render } from 'astro:content';
import { getProjectsForLang } from '../../../i18n/utils';

export async function getStaticPaths() {
	const projects = await getProjectsForLang('en');
	return projects.map(({ entry, slug }) => ({
		params: { id: slug },
		props: { project: entry },
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);
const year = project.data.date.getFullYear();
---

<Base title={project.data.title} description={project.data.description} type="article">
	<article class="section container">
		<a class="back" href="/en/projects/">← Projects</a>
		<span class="tech">{project.data.tags.join(' · ')} · {year}</span>
		<h1>{project.data.title}</h1>
		<div class="body">
			<Content />
		</div>
	</article>
</Base>

<style>
	.back {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 14px;
		color: var(--ink-soft);
		text-decoration: none;
		margin-bottom: 24px;
	}
	.tech {
		display: block;
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--accent);
		margin-bottom: 12px;
	}
	h1 {
		font-size: 40px;
		font-weight: 600;
		letter-spacing: -0.5px;
		color: var(--ink);
		max-width: 760px;
	}
	.body {
		margin-top: 32px;
		max-width: 680px;
		color: var(--ink-soft);
		font-size: 17px;
		line-height: 1.7;
	}
</style>

---
import Base from '../../../layouts/Base.astro';
import ProjectRow from '../../../components/ProjectRow.astro';
import EmptyState from '../../../components/EmptyState.astro';
import { useTranslations, getProjectsForLang } from '../../../i18n/utils';
import { socials } from '../../../i18n/ui';

const lang = 'en';
const t = useTranslations(lang);
const projects = await getProjectsForLang(lang);
const tags = [...new Set(projects.flatMap(({ entry }) => entry.data.tags))];
---

<Base title={t('projects.page.title')} description={t('projects.page.sub')}>
	<section class="section">
		<div class="container">
			<span class="eyebrow">{t('projects.page.eyebrow')}</span>
			<h1>{t('projects.page.title')}</h1>
			<p class="sub">{t('projects.page.sub')}</p>

			{
				projects.length > 0 && (
					<div class="filters">
						<button class="filter active" data-filter="all">
							{t('nav.all')}
						</button>
						{tags.map((tag) => (
							<button class="filter" data-filter={tag}>
								{tag}
							</button>
						))}
					</div>
				)
			}

			{
				projects.length > 0 ? (
					<div class="list">
						{projects.map(({ entry, slug }, i) => (
							<ProjectRow project={entry} href={`/en/projects/${slug}/`} index={i + 1} />
						))}
					</div>
				) : (
					<div class="empty-wrap">
						<EmptyState message={t('projects.empty')} />
					</div>
				)
			}

			<div class="cta">
				<a class="see-all" href={socials.github} target="_blank" rel="noreferrer">
					<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.089-.744.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.605-2.665-.3-5.467-1.332-5.467-5.93 0-1.31.469-2.381 1.236-3.221-.124-.303-.535-1.523.117-3.176 0 0 1.008-.322 3.301 1.23A11.5 11.5 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.873.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.61-2.807 5.625-5.479 5.921.43.372.823 1.102.823 2.222 0 1.606-.015 2.898-.015 3.293 0 .322.216.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
					{t('projects.cta')} →
				</a>
			</div>
		</div>
	</section>
</Base>

<style>
	h1 {
		font-size: 56px;
		font-weight: 600;
		letter-spacing: -1.5px;
		line-height: 1.05;
		color: var(--ink);
		max-width: 760px;
	}
	.sub {
		margin-top: 20px;
		max-width: 560px;
		color: var(--ink-soft);
		font-size: 17px;
		line-height: 1.6;
	}
	.filters {
		margin-top: 40px;
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}
	.filter {
		font-family: var(--font-mono);
		font-size: 13px;
		font-weight: 500;
		color: var(--ink-soft);
		background: transparent;
		border: 1px solid var(--line);
		border-radius: 999px;
		padding: 8px 16px;
		cursor: pointer;
	}
	.filter.active {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--on-accent);
	}
	.list {
		margin-top: 32px;
		border-bottom: 1px solid var(--line);
	}
	.empty-wrap {
		margin-top: 32px;
	}
	.cta {
		margin-top: 40px;
		display: flex;
		justify-content: center;
	}
	.see-all {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-family: var(--font-mono);
		font-size: 14px;
		font-weight: 600;
		color: var(--accent);
		text-decoration: none;
	}
	.see-all svg {
		width: 16px;
		height: 16px;
	}
</style>

<script>
	function setup() {
		const filters = document.querySelectorAll<HTMLButtonElement>('.filter');
		const rows = document.querySelectorAll<HTMLElement>('.list > a');

		filters.forEach((btn) => {
			btn.addEventListener('click', () => {
				filters.forEach((b) => b.classList.remove('active'));
				btn.classList.add('active');
				const tag = btn.dataset.filter;
				rows.forEach((row) => {
					const rowTags = row.dataset.tags?.split(',') ?? [];
					row.style.display = tag === 'all' || rowTags.includes(tag ?? '') ? '' : 'none';
				});
			});
		});
	}

	document.addEventListener('astro:page-load', setup);
</script>

---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import { getProjectsForLang, useTranslations } from '../../i18n/utils';

export async function getStaticPaths() {
	const projects = await getProjectsForLang('sv');
	return projects.map(({ entry, slug }) => ({
		params: { id: slug },
		props: { project: entry },
	}));
}

const t = useTranslations('sv');
const { project } = Astro.props;
const { Content } = await render(project);
const year = project.data.date.getFullYear();
---

<Base title={project.data.title} description={project.data.description} type="article">
	<article class="section container">
		<a class="back" href="/projects/">← Projekt</a>
		<span class="tech">{project.data.tags.join(' · ')} · {year}</span>
		<h1>{project.data.title}</h1>
		{
			project.data.thumbnail && (
				<div class="shot">
					<Image src={project.data.thumbnail} alt="" width={760} height={420} />
				</div>
			)
		}
		<div class="body">
			<Content />
		</div>
		<div class="links">
			{
				project.data.url && (
					<a class="visit" href={project.data.url} target="_blank" rel="noreferrer">
						{t('projects.visit')}
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M7 17 17 7M7 7h10v10" />
						</svg>
					</a>
				)
			}
			{
				project.data.repoUrl && (
					<a class="visit" href={project.data.repoUrl} target="_blank" rel="noreferrer">
						{t('projects.viewCode')}
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M7 17 17 7M7 7h10v10" />
						</svg>
					</a>
				)
			}
		</div>
	</article>
</Base>

<style>
	.back {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 14px;
		color: var(--ink-soft);
		text-decoration: none;
		margin-bottom: 24px;
	}
	.tech {
		display: block;
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--accent);
		margin-bottom: 12px;
	}
	h1 {
		font-size: 40px;
		font-weight: 600;
		letter-spacing: -0.5px;
		color: var(--ink);
		max-width: 760px;
	}
	.shot {
		margin-top: 32px;
		max-width: 760px;
		border-radius: var(--radius);
		overflow: hidden;
		border: 1px solid var(--line);
		background: var(--accent-tint);
	}
	.shot :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.body {
		margin-top: 32px;
		max-width: 680px;
		color: var(--ink-soft);
		font-size: 17px;
		line-height: 1.7;
	}
	.links {
		margin-top: 32px;
		display: flex;
		flex-wrap: wrap;
		gap: 24px;
	}
	.visit {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-family: var(--font-mono);
		font-size: 14px;
		font-weight: 600;
		color: var(--accent);
		text-decoration: none;
	}
	.visit svg {
		width: 16px;
		height: 16px;
	}
</style>
